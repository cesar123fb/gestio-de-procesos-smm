rules_version = '2';

// Reglas de seguridad de Storage — Gestión de Proyectos
// Pegar en: Consola de Firebase → Storage → Reglas → Publicar
service firebase.storage {
  match /b/{bucket}/o {
    match /gestion/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/config/acceso).data.emails;
      allow write: if request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in firestore.get(/databases/(default)/documents/config/acceso).data.emails
        && request.resource.size < 40 * 1024 * 1024;
    }
  }
}
